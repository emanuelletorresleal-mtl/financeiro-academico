{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase.rules",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html|webmanifest|svg)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firebase.rules"
  }
}
